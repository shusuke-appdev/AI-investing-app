# AI
GEMINI_API_KEY=your_gemini_api_key_here

# Deployment mode. Missing APP_MODE defaults to public_readonly (fail-safe).
# private has no built-in authentication; use it only locally or behind access control.
APP_MODE=private

# Market data
FINNHUB_API_KEY=your_finnhub_api_key_here
JQUANTS_API_KEY=your_jquants_api_key_here
EDINET_API_KEY=your_edinet_api_key_here
MARKETDATA_TOKEN=your_marketdata_token_here
# off: yfinance only / shadow: compare but retain yfinance / preferred: MarketData.app first
MARKETDATA_OPTIONS_MODE=preferred

# Optional remote storage
SUPABASE_URL=your_supabase_url_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Legacy compatibility only. Prefer SUPABASE_SECRET_KEY for new environments.
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_here
# SUPABASE_KEY=your_legacy_supabase_key_here
